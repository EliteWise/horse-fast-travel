<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GamePath)/MonoGame.Framework.dll')"
           Text="Pass -p:GamePath=&quot;path to Stardew Valley&quot; (MonoGame.Framework.dll is required)." />
  </Target>
  <ItemGroup>
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)/MonoGame.Framework.dll" />
    <Compile Include="../ModConfig.cs" Link="ModConfig.cs" />
    <Compile Include="../RidePath.cs" Link="RidePath.cs" />
    <Compile Include="../TravelPayment.cs" Link="TravelPayment.cs" />
  </ItemGroup>
</Project>
